<?xml version="1.0" encoding="utf-8"?>
<!-- The whole widget is one painted picture (ParkWidgetPaint), redrawn at the widget's own size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pokepark_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="0dp" android:clipToOutline="true"
    android:background="@drawable/pokepark_widget_background">
    <ImageView android:id="@+id/pokepark_frame"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/pokepark_widget_description" />
</FrameLayout>
