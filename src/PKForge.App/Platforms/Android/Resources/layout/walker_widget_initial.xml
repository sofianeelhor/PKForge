<?xml version="1.0" encoding="utf-8"?>
<!-- What the launcher shows before PKForge's first picture: the widget's neutral face (its art and the PKForge mark, no claim about its data), painted
     (HomeWidgetPaint at 2x2), so a host that photographs the widget early still keeps a real face. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToOutline="true"
    android:background="@drawable/home_widget_background">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:src="@drawable/walker_widget_initial_image"
        android:contentDescription="@string/walker_widget_description" />
</FrameLayout>
