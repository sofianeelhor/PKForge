<?xml version="1.0" encoding="utf-8"?>
<!-- What a widget shows if painting it ever fails: a neutral word and a tap that still opens PKForge,
     never a sample Pokémon that could pass for the real state. Before the first picture, each widget
     shows its own painted empty state instead (*_widget_initial). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_loading_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipToOutline="true"
    android:background="@drawable/home_widget_background">
    <TextView android:id="@+id/home_widget_loading_text"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="12dp"
        android:text="@string/home_widget_loading"
        android:textColor="#204050" android:textSize="14sp" />
</FrameLayout>
