<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 by default, resizable to 4x2 and 4x4 (the picture is repainted for each size). Cocoon and
     iiSU map these sizes on their own grids and start from the smallest, so 2x2 stands on its own.
     No configure activity: everything is chosen in PKForge's Widgets menu. updatePeriodMillis is the
     30-minute floor and never wakes a sleeping device; PKForge also pushes a picture when data changes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="530dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/egg_widget_initial"
    android:previewLayout="@layout/egg_widget_preview"
    android:previewImage="@drawable/egg_widget_preview_image"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/egg_widget_description" />
