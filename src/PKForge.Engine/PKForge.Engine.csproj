<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PKForge.Engine</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PKForge.Domain\PKForge.Domain.csproj" />
    <ProjectReference Include="..\..\external\PKHeX\PKHeX.Core\PKHeX.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PKForge.AutoMod/PKForge.AutoMod.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DexGen" />
    <InternalsVisibleTo Include="PKForge.Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pokémon Unbound ROM-truth tables from the MIT-licensed PUSE project
         (github.com/Zannael/PUSE), vendored as data; see Unbound/Data/README.md. -->
    <EmbeddedResource Include="Unbound/Data/*" LogicalName="unbound.%(Filename)%(Extension)" />
    <!-- Pokémon Radical Red v4.1 species/item tables (CFRU internal ids), extracted by
         eliyahu1702/Rad-Red-4.1-Team-Exporter and cross-checked against the owner's
         device save; see RadicalRed/Data/README.md. -->
    <EmbeddedResource Include="RadicalRed/Data/*" LogicalName="radicalred.%(Filename)%(Extension)" />
    <!-- Pokémon GS Chronicles tables, generated by tools/GscTables/generate.py from the
         game's engine source (github.com/G0LD/GS-Chronicles-Engine, pinned commit in each header). -->
    <EmbeddedResource Include="GsChronicles/Data/*" LogicalName="gschronicles.%(Filename)%(Extension)" />
    <!-- Pokémon Quetzal has no vendored third-party tables: its ids fall back
         to PKHeX's national names and, above those, to the raw stored id. The
         bills-pc reference maps are NOT shipped (no license file). -->
    <!-- Soul Gold tables generated from Eemeliri/soulgold @ e738033.
         Provenance in SoulGold/Data/README.md (the README itself is not embedded). -->
    <EmbeddedResource Include="SoulGold/Data/*.json" LogicalName="soulgold.%(Filename)%(Extension)" />
    <!-- pokeemerald-expansion tables generated from rh-hideout/pokeemerald-expansion
         (1.17.x). Provenance in Expansion/Data/README.md (not embedded). -->
    <EmbeddedResource Include="Expansion/Data/*.json" LogicalName="expansion.%(Filename)%(Extension)" />
    <!-- Elite Redux tables generated from Elite-Redux/er-config (the proto submodule of
         eliteredux-source). Provenance in EliteRedux/Data/README.md (not embedded). -->
    <EmbeddedResource Include="EliteRedux/Data/*.json" LogicalName="eliteredux.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
