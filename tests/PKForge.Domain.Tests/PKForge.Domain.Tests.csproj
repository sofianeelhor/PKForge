<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exercise the read-only park coordinator on desktop with an in-memory
         Preferences adapter, without booting the Android/Maui runtime. -->
    <Compile Include="../../src/PKForge.App/Services/PokeparkService.cs" Link="App/PokeparkService.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../src/PKForge.Domain/PKForge.Domain.csproj" />
    <ProjectReference Include="../../src/PKForge.Infrastructure/PKForge.Infrastructure.csproj" />
  </ItemGroup>
</Project>
